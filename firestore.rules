rules_version = '2';

// ===============================================================
// Assumed Data Model (Cloud Firestore, Standard edition, (default) db)
// ===============================================================
//
// Collection: profiles            Document ID: {uid}
//   Public profile, readable by any signed-in user. Holds NO email or
//   other private data (the email lives only in Firebase Auth).
//   - uid: string (required, == document ID, immutable)
//   - username: string (required, 3-20 chars [A-Za-z0-9_], immutable)
//   - usernameLower: string (required, == username.lower(), immutable)
//   - displayName: string (required, 1-50 chars)
//   - booksFinished: int (required, 0..100000)
//   - currentStreak: int (required, 0..100000)
//   - longestStreak: int (required, 0..100000)
//   - badgeCount: int (required, 0..100)
//   - bio: string (optional, 0-160 chars)
//   - hasPhoto: bool (optional; true when avatars/{uid} holds a photo)
//   - createdAt: timestamp (required, == request.time on create, immutable)
//   - updatedAt: timestamp (required, == request.time on every write)
//
// Collection: avatars             Document ID: {uid}
//   Uploaded profile photo, kept apart from profiles so list reads stay
//   small. Readable by any signed-in user.
//   - uid: string (== document ID)
//   - photo: string (base64 JPEG, 1..150000 chars, ~110 KB)
//   - updatedAt: timestamp (== request.time)
//
// Collection: usernames           Document ID: {usernameLower}
//   Uniqueness index for usernames, claimed in the same batch as the
//   profile. Never updated or deleted by clients. Single-document reads
//   are public so signup can check availability before the account exists.
//   - uid: string (required, == request.auth.uid)
//
// Collection: friendRequests      Document ID: {fromUid}_{toUid}
//   Pending request; deleted when accepted, declined or cancelled.
//   - fromUid: string (required, == request.auth.uid)
//   - toUid: string (required, != fromUid, must have a profile)
//   - fromUsername / fromDisplayName: string (copied from sender profile)
//   - toUsername / toDisplayName: string (copied from recipient profile)
//   - createdAt: timestamp (== request.time)
//
// Collection: users/{uid}/friends Document ID: {friendUid}
//   One document on each side of a friendship. Can only be created while
//   the matching friend request exists (i.e. by accepting it).
//   - uid: string (== friendUid)
//   - username / displayName: string (copied from the friend's profile)
//   - since: timestamp (== request.time)
//
// Collection: users/{uid}/activity Document ID: auto
//   Reading activity, visible to the owner and their friends only.
//   - type: 'started' | 'finished' | 'badge' | 'review'
//   - title, author, bookKey: string (<= 200 chars, may be empty for badges)
//   - badgeId, badgeTitle: string (<= 60 chars, may be empty)
//   - rating: int 0..5 (0 when not a review)
//   - createdAt: timestamp (== request.time)
//
// Collection: books/{bookKey}/reviews Document ID: {uid}
//   One review per user per book, readable by any signed-in user.
//   - uid: string (== document ID == request.auth.uid, immutable)
//   - username / displayName: string (copied from the author's profile)
//   - rating: int 1..5
//   - text: string (<= 2000 chars, may be empty)
//   - title, author: string (<= 200 chars)
//   - createdAt: timestamp (== request.time on create, immutable)
//   - updatedAt: timestamp (== request.time on every write)
//
// Counts on profiles are self-reported by the app and are not verified
// server-side; treat them as informational.
//
// Community collections (posts, reactions, comments) are described in the
// COMMUNITY block near the end of this file.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function uidUnchanged() {
      return incoming().uid == resource.data.uid;
    }

    function uidNotModified() {
      return !incoming().diff(resource.data).affectedKeys().hasAny(['uid']);
    }

    function isString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isInt(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    function profileOf(uid) {
      return get(profilePath(uid)).data;
    }

    function areFriends(ownerUid, otherUid) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/friends/$(otherUid));
    }

    function requestExists(fromUid, toUid) {
      return exists(/databases/$(database)/documents/friendRequests/$(fromUid + '_' + toUid));
    }

    // -------------------------------------------------------------
    // Domain validators
    // -------------------------------------------------------------
    function isValidUsername(name) {
      return name is string && name.matches('^[A-Za-z0-9_]{3,20}$');
    }

    function isValidProfile(uid) {
      let data = incoming();
      return data.keys().hasOnly(['uid', 'username', 'usernameLower', 'displayName',
          'booksFinished', 'currentStreak', 'longestStreak', 'badgeCount',
          'bio', 'hasPhoto', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['uid', 'username', 'usernameLower', 'displayName',
          'booksFinished', 'currentStreak', 'longestStreak', 'badgeCount',
          'createdAt', 'updatedAt'])
        && data.uid == uid
        && isValidUsername(data.username)
        && data.usernameLower == data.username.lower()
        && isString(data.displayName, 1, 50)
        && isInt(data.booksFinished, 0, 100000)
        && isInt(data.currentStreak, 0, 100000)
        && isInt(data.longestStreak, 0, 100000)
        && isInt(data.badgeCount, 0, 100)
        && (!('bio' in data) || isString(data.bio, 0, 160))
        && (!('hasPhoto' in data) || data.hasPhoto is bool)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidFriendRequest(fromUid, toUid) {
      let data = incoming();
      let sender = profileOf(fromUid);
      let recipient = profileOf(toUid);
      return data.keys().hasOnly(['fromUid', 'toUid', 'fromUsername', 'fromDisplayName',
          'toUsername', 'toDisplayName', 'createdAt'])
        && data.keys().hasAll(['fromUid', 'toUid', 'fromUsername', 'fromDisplayName',
          'toUsername', 'toDisplayName', 'createdAt'])
        && data.fromUid == fromUid
        && data.toUid == toUid
        && fromUid != toUid
        && data.fromUsername == sender.username
        && data.fromDisplayName == sender.displayName
        && data.toUsername == recipient.username
        && data.toDisplayName == recipient.displayName
        && data.createdAt == request.time;
    }

    function isValidFriend(friendUid) {
      let data = incoming();
      let friend = profileOf(friendUid);
      return data.keys().hasOnly(['uid', 'username', 'displayName', 'since'])
        && data.keys().hasAll(['uid', 'username', 'displayName', 'since'])
        && data.uid == friendUid
        && data.username == friend.username
        && data.displayName == friend.displayName
        && data.since == request.time;
    }

    function isValidActivity() {
      let data = incoming();
      return data.keys().hasOnly(['type', 'title', 'author', 'bookKey', 'badgeId',
          'badgeTitle', 'rating', 'createdAt'])
        && data.keys().hasAll(['type', 'title', 'author', 'bookKey', 'badgeId',
          'badgeTitle', 'rating', 'createdAt'])
        && data.type in ['started', 'finished', 'badge', 'review']
        && isString(data.title, 0, 200)
        && isString(data.author, 0, 200)
        && isString(data.bookKey, 0, 200)
        && isString(data.badgeId, 0, 60)
        && isString(data.badgeTitle, 0, 60)
        && isInt(data.rating, 0, 5)
        && data.createdAt == request.time;
    }

    function isValidReview(uid) {
      let data = incoming();
      let author = profileOf(uid);
      return data.keys().hasOnly(['uid', 'username', 'displayName', 'rating', 'text',
          'title', 'author', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['uid', 'username', 'displayName', 'rating', 'text',
          'title', 'author', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.username == author.username
        && data.displayName == author.displayName
        && isInt(data.rating, 1, 5)
        && isString(data.text, 0, 2000)
        && isString(data.title, 1, 200)
        && isString(data.author, 0, 200)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    // -------------------------------------------------------------
    // profiles
    // -------------------------------------------------------------
    match /profiles/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid)
        && isValidProfile(uid)
        && incoming().createdAt == request.time
        // The username must be claimed for this user in the same batch.
        && getAfter(/databases/$(database)/documents/usernames/$(incoming().usernameLower)).data.uid == uid;
      allow update: if isOwner(uid)
        && isValidProfile(uid)
        && uidNotModified()
        && !incoming().diff(resource.data).affectedKeys()
            .hasAny(['username', 'usernameLower', 'createdAt']);
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // usernames
    // -------------------------------------------------------------
    match /avatars/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid)
        && incoming().keys().hasOnly(['uid', 'photo', 'updatedAt'])
        && incoming().keys().hasAll(['uid', 'photo', 'updatedAt'])
        && incoming().uid == uid
        && isString(incoming().photo, 1, 150000)
        && incoming().updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // -------------------------------------------------------------
    // usernames
    // -------------------------------------------------------------
    match /usernames/{name} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow create: if isAuthenticated()
        && name.matches('^[a-z0-9_]{3,20}$')
        && incoming().keys().hasOnly(['uid'])
        && incoming().uid == request.auth.uid
        // Created together with the owner's profile, which must point back.
        && !exists(profilePath(request.auth.uid))
        && getAfter(profilePath(request.auth.uid)).data.usernameLower == name;
      allow update, delete: if false;
    }

    // -------------------------------------------------------------
    // friendRequests
    // -------------------------------------------------------------
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      allow create: if isAuthenticated()
        && incoming().fromUid == request.auth.uid
        && requestId == incoming().fromUid + '_' + incoming().toUid
        && exists(profilePath(incoming().toUid))
        && !areFriends(incoming().fromUid, incoming().toUid)
        && isValidFriendRequest(incoming().fromUid, incoming().toUid);
      allow update: if false;
      allow delete: if isAuthenticated()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
    }

    // -------------------------------------------------------------
    // users/{uid}/friends and users/{uid}/activity
    // -------------------------------------------------------------
    match /users/{ownerUid} {
      allow read, write: if false;

      match /friends/{friendUid} {
        allow read: if isOwner(ownerUid);
        // Accepting request friendUid -> ownerUid (recipient writes own side),
        // or request ownerUid -> friendUid (recipient writes sender's side).
        // exists() sees the state before the batch, so the request may be
        // deleted in the same batch.
        allow create: if isAuthenticated()
          && ((request.auth.uid == ownerUid && requestExists(friendUid, ownerUid))
              || (request.auth.uid == friendUid && requestExists(ownerUid, friendUid)))
          && isValidFriend(friendUid);
        allow update: if false;
        allow delete: if isOwner(ownerUid) || isOwner(friendUid);
      }

      match /activity/{activityId} {
        allow read: if isOwner(ownerUid)
          || (isAuthenticated() && areFriends(ownerUid, request.auth.uid));
        allow create: if isOwner(ownerUid) && isValidActivity();
        allow update: if false;
        allow delete: if isOwner(ownerUid);
      }

      // ===========================================================
      // BEGIN personal library sync (lib/core/sync, docs/cloud-data.md)
      //
      // users/{uid}/library/{bookKey}        signed-in read (public shelf)
      // users/{uid}/readingState/{bookKey}   owner only
      // users/{uid}/highlights/{remoteId}    owner only
      // users/{uid}/bookmarks/{remoteId}     owner only
      // users/{uid}/sessions/{remoteId}      owner only
      // users/{uid}/badges/{badgeId}         signed-in read (public)
      // users/{uid}/private/settings         owner only
      //
      // Every synced document carries:
      // - updatedAt: timestamp of the edit (client clock; merges keep the
      //   newer one). At most 1 hour ahead of server time, and an update
      //   may never move it backwards, so a stale device cannot overwrite
      //   a newer edit.
      // - syncedAt: == request.time (FieldValue.serverTimestamp()); clients
      //   pull changes since their last syncedAt.
      // Deletes are soft (deleted: true) so other devices see them; hard
      // deletes are left to the owner (e.g. account removal).
      // ===========================================================
      function isSyncTime(value) {
        return value is timestamp
          && value <= request.time + duration.value(1, 'h');
      }

      function isSyncWrite() {
        return isSyncTime(incoming().updatedAt)
          && incoming().syncedAt == request.time
          && (resource == null
              || !('updatedAt' in resource.data)
              || incoming().updatedAt >= resource.data.updatedAt);
      }

      function optString(data, key, max) {
        return !(key in data) || isString(data[key], 0, max);
      }

      function optTimestamp(data, key) {
        return !(key in data) || data[key] is timestamp;
      }

      function isPercent(value) {
        return value is number && value >= 0 && value <= 100;
      }

      // A tombstone may hold only bookKey/deleted/updatedAt/syncedAt (e.g.
      // the old entry after a book's key changed); a live entry needs the
      // full set.
      function isValidLibraryEntry() {
        let data = incoming();
        return data.keys().hasOnly(['bookKey', 'title', 'author', 'genre',
            'shelf', 'progress', 'addedAt', 'finishedAt', 'lastOpenedAt',
            'sourceUrl', 'coverUrl', 'fileHash', 'deleted', 'updatedAt',
            'syncedAt'])
          && data.keys().hasAll(['bookKey', 'deleted', 'updatedAt', 'syncedAt'])
          && isString(data.bookKey, 1, 400)
          && data.deleted is bool
          && (data.deleted == true
              || data.keys().hasAll(['title', 'author', 'shelf', 'progress',
                  'addedAt']))
          && optString(data, 'title', 500)
          && optString(data, 'author', 500)
          && optString(data, 'genre', 100)
          && (!('shelf' in data)
              || data.shelf in ['wantToRead', 'currentlyReading', 'finished'])
          && (!('progress' in data) || isPercent(data.progress))
          && optTimestamp(data, 'addedAt')
          && optTimestamp(data, 'finishedAt')
          && optTimestamp(data, 'lastOpenedAt')
          && optString(data, 'sourceUrl', 2000)
          && optString(data, 'coverUrl', 2000)
          && optString(data, 'fileHash', 128);
      }

      function isValidReadingState() {
        let data = incoming();
        return data.keys().hasOnly(['bookKey', 'lastCfi', 'totalLocations',
            'deleted', 'updatedAt', 'syncedAt'])
          && data.keys().hasAll(['bookKey', 'updatedAt', 'syncedAt'])
          && isString(data.bookKey, 1, 400)
          && optString(data, 'lastCfi', 2000)
          && (!('totalLocations' in data)
              || isInt(data.totalLocations, 0, 10000000))
          && (!('deleted' in data) || data.deleted is bool);
      }

      function isValidHighlight() {
        let data = incoming();
        return data.keys().hasOnly(['bookKey', 'cfiRange', 'selectedText',
            'color', 'note', 'chapterTitle', 'createdAt', 'updatedAt',
            'deleted', 'syncedAt'])
          && data.keys().hasAll(['bookKey', 'cfiRange', 'selectedText', 'color',
            'createdAt', 'updatedAt', 'deleted', 'syncedAt'])
          && isString(data.bookKey, 0, 400)
          && isString(data.cfiRange, 0, 2000)
          && isString(data.selectedText, 0, 10000)
          && isInt(data.color, 0, 50)
          && optString(data, 'note', 10000)
          && optString(data, 'chapterTitle', 500)
          && data.createdAt is timestamp
          && data.deleted is bool;
      }

      function isValidBookmark() {
        let data = incoming();
        return data.keys().hasOnly(['bookKey', 'cfi', 'label', 'percent',
            'createdAt', 'updatedAt', 'deleted', 'syncedAt'])
          && data.keys().hasAll(['bookKey', 'cfi', 'percent', 'createdAt',
            'updatedAt', 'deleted', 'syncedAt'])
          && isString(data.bookKey, 0, 400)
          && isString(data.cfi, 0, 2000)
          && optString(data, 'label', 500)
          && isPercent(data.percent)
          && data.createdAt is timestamp
          && data.deleted is bool;
      }

      function isValidSession() {
        let data = incoming();
        return data.keys().hasOnly(['bookKey', 'startedAt', 'endedAt',
            'durationSeconds', 'startPercent', 'endPercent', 'updatedAt',
            'syncedAt'])
          && data.keys().hasAll(['bookKey', 'startedAt', 'endedAt',
            'durationSeconds', 'startPercent', 'endPercent', 'updatedAt',
            'syncedAt'])
          && isString(data.bookKey, 0, 400)
          && data.startedAt is timestamp
          && data.endedAt is timestamp
          && data.endedAt >= data.startedAt
          && isInt(data.durationSeconds, 0, 604800)
          && isPercent(data.startPercent)
          && isPercent(data.endPercent);
      }

      function isValidBadge(badgeId) {
        let data = incoming();
        return data.keys().hasOnly(['badgeId', 'unlockedAt', 'updatedAt',
            'syncedAt'])
          && data.keys().hasAll(['badgeId', 'unlockedAt', 'updatedAt',
            'syncedAt'])
          && data.badgeId == badgeId
          && isString(badgeId, 1, 60)
          && data.unlockedAt is timestamp;
      }

      // Generic settings map; features add their own keys. Each key's edit
      // time is in stamps, so the merge is per key (no updatedAt ordering).
      function isValidSettings() {
        let data = incoming();
        return data.keys().hasOnly(['values', 'stamps', 'updatedAt', 'syncedAt'])
          && data.keys().hasAll(['values', 'stamps', 'updatedAt', 'syncedAt'])
          && data.values is map
          && data.values.size() <= 200
          && data.stamps is map
          && data.stamps.size() <= 200
          && isSyncTime(data.updatedAt)
          && data.syncedAt == request.time;
      }

      match /library/{bookId} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(ownerUid)
          && isValidLibraryEntry()
          && isSyncWrite();
        allow delete: if isOwner(ownerUid);
      }

      match /readingState/{bookId} {
        allow read: if isOwner(ownerUid);
        allow create, update: if isOwner(ownerUid)
          && isValidReadingState()
          && isSyncWrite();
        allow delete: if isOwner(ownerUid);
      }

      match /highlights/{highlightId} {
        allow read: if isOwner(ownerUid);
        allow create, update: if isOwner(ownerUid)
          && isString(highlightId, 1, 64)
          && isValidHighlight()
          && isSyncWrite();
        allow delete: if isOwner(ownerUid);
      }

      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(ownerUid);
        allow create, update: if isOwner(ownerUid)
          && isString(bookmarkId, 1, 64)
          && isValidBookmark()
          && isSyncWrite();
        allow delete: if isOwner(ownerUid);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(ownerUid);
        allow create, update: if isOwner(ownerUid)
          && isString(sessionId, 1, 64)
          && isValidSession()
          && isSyncWrite();
        allow delete: if isOwner(ownerUid);
      }

      match /badges/{badgeId} {
        allow read: if isAuthenticated();
        allow create, update: if isOwner(ownerUid)
          && isValidBadge(badgeId)
          && isSyncWrite();
        allow delete: if isOwner(ownerUid);
      }

      match /private/{docId} {
        allow read: if isOwner(ownerUid);
        allow create, update: if isOwner(ownerUid)
          && docId == 'settings'
          && isValidSettings();
        allow delete: if isOwner(ownerUid);
      }
      // END personal library sync
      // ===========================================================
    }

    // -------------------------------------------------------------
    // books/{bookKey}/reviews
    // -------------------------------------------------------------
    match /books/{bookKey} {
      allow read, write: if false;

      match /reviews/{uid} {
        allow read: if isAuthenticated();
        allow create: if isOwner(uid)
          && bookKey.size() <= 200
          && isValidReview(uid)
          && incoming().createdAt == request.time;
        allow update: if isOwner(uid)
          && isValidReview(uid)
          && uidUnchanged()
          && incoming().createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }
    }

    // =============================================================
    // COMMUNITY (posts, reactions, comments, public profile reads)
    // Owned by the social feature. See docs/cloud-data.md#community.
    // =============================================================
    //
    // Collection: posts               Document ID: {authorUid}_{suffix}
    //   A feed item. The id must start with the author's uid, so nobody
    //   can take the id of someone else's deterministic post
    //   ({uid}_review_{bookKey}, {uid}_finished_{bookKey}, ...).
    //   - authorUid: string (== request.auth.uid, immutable)
    //   - authorUsername / authorDisplayName: string (== author's profile)
    //   - type: 'started' | 'finished' | 'shelved' | 'progress' | 'review'
    //           | 'rating' | 'quote' | 'badge' (review <-> rating may change)
    //   - visibility: 'public' (any signed-in reader) | 'friends'
    //   - bookKey, title: string (1-200; both '' for badges)
    //   - author: string (0-200), coverUrl: string (0-500, '' or https://)
    //   - rating: int (1..5 for review/rating, else 0)
    //   - text: string (review text or note; 1-2000 for review, '' for
    //           rating, else 0-2000)
    //   - quote: string (1-1000 for quote, else '')
    //   - chapter: string (0-200)
    //   - progress: int (1..99 for progress, else 0)
    //   - badgeId / badgeTitle: string (1-60 for badge, else '')
    //   - reactions: map {like, love, haha, wow, sad: int >= 0}
    //   - commentCount: int >= 0
    //   - commentOpId: string (id of the comment added/removed by the
    //                  write that last changed commentCount)
    //   - createdAt: timestamp (== request.time on create, immutable)
    //   - updatedAt: timestamp (== request.time on every author edit)
    //
    // Collection: posts/{postId}/reactions   Document ID: {reactorUid}
    //   One reaction per reader per post (the id is the reader's uid).
    //   - uid: string (== document ID)
    //   - type: one of the reaction keys above
    //   - username / displayName: string (== reactor's profile)
    //   - updatedAt: timestamp (== request.time)
    //
    // Collection: posts/{postId}/comments    Document ID: auto
    //   - authorUid: string (== request.auth.uid)
    //   - authorUsername / authorDisplayName: string (== author's profile)
    //   - text: string (1-1000)
    //   - parentId: string ('' for a top-level comment, else the id of a
    //               top-level comment on the same post: one level of replies)
    //   - createdAt: timestamp (== request.time)
    //   Comments are not editable.
    //
    // Counters cannot be forged: a post's `reactions` and `commentCount`
    // are only writable by non-authors in the same atomic write that adds,
    // changes or removes the matching reaction/comment, and both sides are
    // checked (the post rule with exists()/existsAfter() on the reaction or
    // comment, the reaction/comment rule with get()/getAfter() on the post).
    // Clients use FieldValue.increment, so concurrent writers do not lose
    // updates; the rules see the post-increment value.
    //
    // Friends-only posts: list queries must constrain authorUid to the user
    // or their friends (`authorUid in [...]`, one query per 30 authors) or
    // ask for visibility == 'public'; the rules evaluate each `in` value.
    //
    // Deleting a post leaves its reactions and comments behind; the rules
    // let anyone delete those once the post is gone, and the app does so
    // right after deleting the post.

    function reactionTypes() {
      return ['like', 'love', 'haha', 'wow', 'sad'];
    }

    function postPath(postId) {
      return /databases/$(database)/documents/posts/$(postId);
    }

    function reactionPath(postId, reactorUid) {
      return /databases/$(database)/documents/posts/$(postId)/reactions/$(reactorUid);
    }

    function commentPath(postId, commentId) {
      return /databases/$(database)/documents/posts/$(postId)/comments/$(commentId);
    }

    // Read access for a post's data (also gates its reactions/comments).
    function canReadPost(post) {
      return isAuthenticated()
        && (post.visibility == 'public'
            || post.authorUid == request.auth.uid
            || areFriends(post.authorUid, request.auth.uid));
    }

    function isHttpsOrEmpty(value) {
      return value == '' || value.matches('^https://[^\\s]{1,490}$');
    }

    // Content fields of a post (shared by create and author edits).
    function isValidPostContent(data) {
      let isBook = data.type != 'badge';
      let isRated = data.type in ['review', 'rating'];
      return data.type in ['started', 'finished', 'shelved', 'progress',
            'review', 'rating', 'quote', 'badge']
        && data.visibility in ['public', 'friends']
        && isString(data.bookKey, isBook ? 1 : 0, isBook ? 200 : 0)
        && isString(data.title, isBook ? 1 : 0, isBook ? 200 : 0)
        && isString(data.author, 0, 200)
        && isString(data.coverUrl, 0, 500) && isHttpsOrEmpty(data.coverUrl)
        && isInt(data.rating, isRated ? 1 : 0, isRated ? 5 : 0)
        && isString(data.text,
            data.type == 'review' ? 1 : 0,
            data.type == 'rating' ? 0 : 2000)
        && isString(data.quote,
            data.type == 'quote' ? 1 : 0,
            data.type == 'quote' ? 1000 : 0)
        && isString(data.chapter, 0, 200)
        && isInt(data.progress,
            data.type == 'progress' ? 1 : 0,
            data.type == 'progress' ? 99 : 0)
        && isString(data.badgeId,
            data.type == 'badge' ? 1 : 0,
            data.type == 'badge' ? 60 : 0)
        && isString(data.badgeTitle,
            data.type == 'badge' ? 1 : 0,
            data.type == 'badge' ? 60 : 0);
    }

    function postKeys() {
      return ['authorUid', 'authorUsername', 'authorDisplayName', 'type',
        'visibility', 'bookKey', 'title', 'author', 'coverUrl', 'rating',
        'text', 'quote', 'chapter', 'progress', 'badgeId', 'badgeTitle',
        'reactions', 'commentCount', 'commentOpId', 'createdAt', 'updatedAt'];
    }

    function isValidNewPost(postId) {
      let data = incoming();
      let author = profileOf(request.auth.uid);
      return data.keys().hasOnly(postKeys())
        && data.keys().hasAll(postKeys())
        && postId.matches(request.auth.uid + '_[A-Za-z0-9_|.:-]{1,400}')
        && data.authorUid == request.auth.uid
        && data.authorUsername == author.username
        && data.authorDisplayName == author.displayName
        && isValidPostContent(data)
        && data.reactions == {'like': 0, 'love': 0, 'haha': 0, 'wow': 0, 'sad': 0}
        && data.commentCount == 0
        && data.commentOpId == ''
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // The author edits content (e.g. re-saving a review). Counters,
    // authorship and createdAt are untouched; type may only switch between
    // review and rating.
    function isValidPostEdit() {
      let data = incoming();
      return isAuthenticated()
        && resource.data.authorUid == request.auth.uid
        && data.diff(resource.data).affectedKeys().hasOnly(['authorDisplayName',
            'type', 'visibility', 'bookKey', 'title', 'author', 'coverUrl',
            'rating', 'text', 'quote', 'chapter', 'progress', 'badgeId',
            'badgeTitle', 'updatedAt'])
        && data.authorDisplayName == profileOf(request.auth.uid).displayName
        && (data.type == resource.data.type
            || (data.type in ['review', 'rating']
                && resource.data.type in ['review', 'rating']))
        && data.bookKey == resource.data.bookKey
        && isValidPostContent(data)
        && data.updatedAt == request.time;
    }

    // Change of one reaction counter for the reaction of `before` -> `after`
    // ('' = no reaction).
    function reactionDelta(type, before, after) {
      return (type == after ? 1 : 0) - (type == before ? 1 : 0);
    }

    // The user's reaction changed in this write, and `reactions` moved by
    // exactly that change.
    function isReactionCounterUpdate(postId) {
      let path = reactionPath(postId, request.auth.uid);
      let before = exists(path) ? get(path).data.type : '';
      let after = existsAfter(path) ? getAfter(path).data.type : '';
      let old = resource.data.reactions;
      let next = incoming().reactions;
      return isAuthenticated()
        && incoming().diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && before != after
        && next.keys().hasOnly(reactionTypes())
        && next.keys().hasAll(reactionTypes())
        && next.like == old.like + reactionDelta('like', before, after)
        && next.love == old.love + reactionDelta('love', before, after)
        && next.haha == old.haha + reactionDelta('haha', before, after)
        && next.wow == old.wow + reactionDelta('wow', before, after)
        && next.sad == old.sad + reactionDelta('sad', before, after);
    }

    // commentCount moved by one, matching the comment named by commentOpId
    // being created or deleted in this same write.
    function isCommentCounterUpdate(postId) {
      let opId = incoming().commentOpId;
      let path = commentPath(postId, opId);
      return isAuthenticated()
        && incoming().diff(resource.data).affectedKeys()
            .hasOnly(['commentCount', 'commentOpId'])
        && isString(opId, 1, 100)
        && ((incoming().commentCount == resource.data.commentCount + 1
              && !exists(path) && existsAfter(path))
            || (incoming().commentCount == resource.data.commentCount - 1
              && exists(path) && !existsAfter(path)));
    }

    match /posts/{postId} {
      // A missing post may be read (so the app can check before creating
      // its deterministic posts); it reveals nothing.
      allow read: if isAuthenticated()
        && (resource == null || canReadPost(resource.data));
      allow create: if isAuthenticated() && isValidNewPost(postId);
      allow update: if isValidPostEdit()
        || (canReadPost(resource.data)
            && (isReactionCounterUpdate(postId)
                || isCommentCounterUpdate(postId)));
      allow delete: if isAuthenticated()
        && resource.data.authorUid == request.auth.uid;

      match /reactions/{reactorUid} {
        allow read: if canReadPost(get(postPath(postId)).data);

        // The post's counter for the new type must go up by one in the
        // same write (isReactionCounterUpdate checks the full map).
        allow create, update: if isOwner(reactorUid)
          && incoming().keys().hasOnly(['uid', 'type', 'username',
              'displayName', 'updatedAt'])
          && incoming().keys().hasAll(['uid', 'type', 'username',
              'displayName', 'updatedAt'])
          && incoming().uid == reactorUid
          && incoming().type in reactionTypes()
          && incoming().username == profileOf(reactorUid).username
          && incoming().displayName == profileOf(reactorUid).displayName
          && incoming().updatedAt == request.time
          && canReadPost(get(postPath(postId)).data)
          && getAfter(postPath(postId)).data.reactions[incoming().type]
              == get(postPath(postId)).data.reactions[incoming().type] + 1;

        // Own reaction with the counter going down, or clean-up after the
        // post was deleted.
        allow delete: if isAuthenticated()
          && (!existsAfter(postPath(postId))
              || (isOwner(reactorUid)
                  && getAfter(postPath(postId)).data.reactions[resource.data.type]
                      == get(postPath(postId)).data.reactions[resource.data.type] - 1));
      }

      match /comments/{commentId} {
        allow read: if canReadPost(get(postPath(postId)).data);

        allow create: if isAuthenticated()
          && incoming().keys().hasOnly(['authorUid', 'authorUsername',
              'authorDisplayName', 'text', 'parentId', 'createdAt'])
          && incoming().keys().hasAll(['authorUid', 'authorUsername',
              'authorDisplayName', 'text', 'parentId', 'createdAt'])
          && incoming().authorUid == request.auth.uid
          && incoming().authorUsername == profileOf(request.auth.uid).username
          && incoming().authorDisplayName == profileOf(request.auth.uid).displayName
          && isString(incoming().text, 1, 1000)
          && incoming().createdAt == request.time
          && canReadPost(get(postPath(postId)).data)
          // Replies only to existing top-level comments.
          && (incoming().parentId == ''
              || (isString(incoming().parentId, 1, 100)
                  && get(commentPath(postId, incoming().parentId)).data.parentId == ''))
          && getAfter(postPath(postId)).data.commentOpId == commentId
          && getAfter(postPath(postId)).data.commentCount
              == get(postPath(postId)).data.commentCount + 1;

        allow update: if false;

        // The comment's author, the post's author, or (for a reply) the
        // author of the comment it answers; the counter goes down with it.
        // Anyone may clean up after the post was deleted.
        allow delete: if isAuthenticated()
          && (!existsAfter(postPath(postId))
              || ((resource.data.authorUid == request.auth.uid
                   || get(postPath(postId)).data.authorUid == request.auth.uid
                   || (resource.data.parentId != ''
                       && get(commentPath(postId, resource.data.parentId)).data.authorUid
                           == request.auth.uid))
                  && getAfter(postPath(postId)).data.commentOpId == commentId
                  && getAfter(postPath(postId)).data.commentCount
                      == get(postPath(postId)).data.commentCount - 1));
      }
    }

    // A reader's ratings across all books (collection-group query on
    // books/{bookKey}/reviews), for their profile. Reviews are already
    // public per book.
    match /{path=**}/reviews/{reviewUid} {
      allow read: if isAuthenticated();
    }

    // Public profile pieces read by the profile page. Friend lists are
    // public like on Goodreads, so anyone signed in can count them; writes
    // stay with the rules above. Library and badges are written by the
    // sync feature (its rules are elsewhere); these read rules mirror
    // docs/cloud-data.md and are harmless duplicates once both exist.
    match /users/{ownerUid}/friends/{friendUid} {
      allow read: if isAuthenticated();
    }

    match /users/{ownerUid}/library/{bookKey} {
      allow read: if isAuthenticated();
    }

    match /users/{ownerUid}/badges/{badgeId} {
      allow read: if isAuthenticated();
    }

    // =============================================================
    // END COMMUNITY
    // =============================================================
  }
}
